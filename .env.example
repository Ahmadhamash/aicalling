# ---------------------------------------------------------------------------
# Nawa AI — environment configuration
# Copy to `.env` and fill in the secrets. Never commit your real `.env`.
# ---------------------------------------------------------------------------

# --- Service ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-key-here
# Optional: point at an OpenAI-compatible gateway (leave blank for OpenAI).
# OPENAI_BASE_URL=
# Swap the model here without touching code:
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=250
LLM_TIMEOUT_S=15

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Qdrant ---
# In docker-compose this is http://qdrant:6333; locally http://localhost:6333
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=          # only for Qdrant Cloud
QDRANT_COLLECTION=nawa_kb
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.30

# --- Redis ---
# In docker-compose this is redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
EMBEDDING_CACHE_TTL_S=604800   # 7 days
STATE_TTL_S=7200               # 2 hours
HISTORY_TURNS=6
